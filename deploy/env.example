MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=somanifabs
CORS_ORIGINS=*
JWT_SECRET=put_a_long_random_string_here
SUPER_ADMIN_USERNAME=your_admin_username
SUPER_ADMIN_PASSWORD=your_admin_password
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=low

# ---- WhatsApp (Countr OS bot) — see docs/whatsapp-setup.md ----
