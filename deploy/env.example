WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Only needed to submit image-header templates (follow-up looks, win-back).
WHATSAPP_APP_ID=
# Your site address, used for the /r/<slug>/review and /r/<slug>/map links.
PUBLIC_BASE_URL=https://your-domain.com
